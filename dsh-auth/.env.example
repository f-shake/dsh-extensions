# dsh-auth 配置样例
#
# 实际配置放在同目录的 .env（不入库，已在 .gitignore 里）。
# 生成步骤见 README-部署说明.md：先 setup_totp.py，再 set-password.py。
#
# 下面列的是字段清单与取值形态，敏感项留空，不要填入真实值。

# TOTP 密钥：base32，32 个字符，由 setup_totp.py 生成
DSH_TOTP_SECRET=

# 密码哈希：PBKDF2-SHA256，形如 pbkdf2_sha256$<轮数>$<salt>$<hash>，由 set-password.py 生成
DSH_PWD_HASH=

# 会话 cookie 的 HMAC 密钥：随机串（约 43 字符），换掉即全员下线
DSH_COOKIE_SECRET=

# 对外域名
DSH_PUBLIC_HOST=dsn.example.com

# 本机 dsh 的 origin
DSH_LOCAL_ORIGIN=http://127.0.0.1:8791

# 会话有效期（秒），默认 7 天
DSH_SESSION_TTL=604800

# dsh 启动时打印的登录 token 所在文件（只有一个候选时用这个）
DSH_TOKEN_FILE=C:\dsh\aa.out.log

# 有多个候选时用这个，按分号分隔（这一项优先于 DSH_TOKEN_FILE）：
# DSH_TOKEN_FILES=C:\dsh\aa.out.log;C:\dsh\aa.test.out.log

# dsh 的凭据文件（离线兜底签发 cookie 时用）
DSH_CRED_FILE=C:\Users\<you>\.dsh\.credentials.yaml
