{
  "name": "@local/typo-proof",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "日记错别字检查：本地小模型采样三次、云端盲复核，确认的改动以修订模式写进 docx 副本",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/",
    "check:ui": "node e2e/interaction-check.mjs",
    "preview": "node e2e/preview.mjs"
  },
  "license": "MIT"
}
