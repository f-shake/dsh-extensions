{
  "name": "@local/deliver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "文件投递：把宿主上的文件变成登录态下可下载的投递条，并在右侧栏提供一个投递箱",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "license": "MIT"
}
