{
  "name": "@local/git-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "右侧边栏的 Git 面板：选择会话目录下的子仓库，查看未提交文件（已暂存/未暂存/未跟踪）与逐文件差异",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/client.test.js test/host.test.js"
  },
  "license": "MIT"
}
