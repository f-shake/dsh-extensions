{
  "name": "@local/swipe-sidebar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "窄屏手势：左半屏右滑展开左侧抽屉、右半屏左滑展开右侧栏，抽屉开着时反向滑动收起",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "license": "MIT"
}
